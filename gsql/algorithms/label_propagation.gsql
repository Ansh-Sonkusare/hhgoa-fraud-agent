// gsql/algorithms/label_propagation.gsql -- WS2. Louvain-equivalent
// clustering (no GDS/tg_louvain on this Community Edition build): standard
// label-propagation over the same Card-Device-Address-RecipientEmail
// sharing projection as community_components.gsql, honoring as_of. Unlike
// the min-label WCC in community_components.gsql (which merges an entire
// connected chain into one component), this picks each card's MOST COMMON
// neighbor label (majority vote, ties broken by smallest label) -- a
// modularity-style clustering that can split a large weakly-connected
// component into denser sub-clusters.
//
// Documented simplification: a single synchronous voting pass from each
// card's own-id initial label (not iterated to a fixed point -- clearing
// and rebuilding per-vertex MapAccum votes across WHILE rounds was not
// reliable on this build, see docs/decisions.md). One pass is the standard
// first step of LPA and already distinguishes hub-sharing clusters from
// pure chains; further rounds are future work if the discovery results
// warrant it.
//
// max_hub_degree: same hub-collapse guard as community_components.gsql --
// shared vertices touching more than max_hub_degree distinct cards are
// excluded from voting (see that file's comment for why).
CREATE QUERY label_propagation(DATETIME as_of, INT max_hub_degree) FOR GRAPH hhgoa_fraud {
  MinAccum<STRING> @label;
  SumAccum<INT>    @degree;
  MapAccum<STRING, SumAccum<INT>> @votes;
  MinAccum<STRING> @bestLabel;
  MaxAccum<INT> @bestCount;
  MapAccum<STRING, SumAccum<INT>> @@comp_size;

  AllCards = {Card.*};
  Init = SELECT c FROM AllCards:c
         POST-ACCUM c.@label += c.id;

  DevAll = SELECT d FROM AllCards:c-(CARD_DEVICE:e)-:d
           WHERE e.first_ts <= as_of
           ACCUM d.@degree += 1;
  AddrAll = SELECT a FROM AllCards:c-(CARD_ADDRESS:e)-:a
            WHERE e.first_ts <= as_of
            ACCUM a.@degree += 1;
  EmAll = SELECT x FROM AllCards:c-(CARD_RECIPIENT_EMAIL:e)-:x
          WHERE e.first_ts <= as_of
          ACCUM x.@degree += 1;

  Dev = SELECT d FROM AllCards:c-(CARD_DEVICE:e)-:d
        WHERE e.first_ts <= as_of AND d.@degree <= max_hub_degree
        ACCUM d.@label += c.@label;
  BackDev = SELECT c2 FROM Dev:d-(reverse_CARD_DEVICE:e)-:c2
            WHERE e.first_ts <= as_of
            ACCUM c2.@votes += (d.@label -> 1);

  Addr = SELECT a FROM AllCards:c-(CARD_ADDRESS:e)-:a
         WHERE e.first_ts <= as_of AND a.@degree <= max_hub_degree
         ACCUM a.@label += c.@label;
  BackAddr = SELECT c2 FROM Addr:a-(reverse_CARD_ADDRESS:e)-:c2
             WHERE e.first_ts <= as_of
             ACCUM c2.@votes += (a.@label -> 1);

  Em = SELECT x FROM AllCards:c-(CARD_RECIPIENT_EMAIL:e)-:x
       WHERE e.first_ts <= as_of AND x.@degree <= max_hub_degree
       ACCUM x.@label += c.@label;
  BackEm = SELECT c2 FROM Em:x-(reverse_CARD_RECIPIENT_EMAIL:e)-:c2
           WHERE e.first_ts <= as_of
           ACCUM c2.@votes += (x.@label -> 1);

  Pick = SELECT c FROM AllCards:c
         ACCUM
           FOREACH (lbl, cnt) IN c.@votes DO
             IF cnt > c.@bestCount THEN
               c.@bestCount += cnt,
               c.@bestLabel += lbl
             END
           END
         POST-ACCUM
           IF c.@bestLabel == "" THEN
             c.@bestLabel += c.id
           END,
           @@comp_size += (c.@bestLabel -> 1);

  PRINT @@comp_size AS cluster_sizes;
}
