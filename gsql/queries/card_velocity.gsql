// gsql/queries/card_velocity.gsql -- WS2, backs contract tool `compute_velocity`
// (contracts/src/tools.ts ComputeVelocity). Count + total amount of a card's
// txns within window_minutes before as_of, ts <= as_of only (PRD sec.8.1).
CREATE QUERY card_velocity(STRING card_id, INT window_minutes, DATETIME as_of) FOR GRAPH hhgoa_fraud {
  SumAccum<INT>    @@count;
  SumAccum<DOUBLE> @@total_amount_usd;

  Cards = {Card.*};
  CardHit = SELECT c FROM Cards:c WHERE c.id == card_id;
  Txns = SELECT t FROM CardHit:c-(MADE)-:t
         WHERE t.ts <= as_of
           AND datetime_to_epoch(t.ts) >= datetime_to_epoch(as_of) - window_minutes * 60
         ACCUM @@count += 1,
               @@total_amount_usd += t.amount_usd;

  // "count" is a reserved word in this GSQL grammar and cannot be used as a
  // PRINT alias (even quoted) -- aliased as txn_count instead; the contract
  // field name `count` is applied by the caller mapping this JSON.
  PRINT @@count AS txn_count, window_minutes AS window_minutes, @@total_amount_usd AS total_amount_usd;
}
