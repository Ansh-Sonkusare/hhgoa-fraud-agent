// gsql/queries/txn_history.gsql -- WS2, backs contract tool
// `get_transaction_history` (contracts/src/tools.ts GetTransactionHistory).
// entity_type is "card" or "customer"; window_hours 0 means "all history up
// to as_of". Rows are ts <= as_of only (PRD sec.8.1).
CREATE QUERY txn_history(STRING entity_type, STRING entity_id, DATETIME as_of, INT window_hours) FOR GRAPH hhgoa_fraud {
  // addr1/id_15/id_23/m-flags are carried because they are the facts that
  // separate the documented patterns from one another: addr1 is the billing
  // region out_of_region_use turns on, id_15 is the New/Found device marker
  // card_not_present_new_device is defined by, and the match flags plus the
  // channel mix are what account_takeover rests on. Without them the caller
  // can only ever describe generic card-not-present activity, whatever the
  // underlying pattern actually is.
  TYPEDEF TUPLE<STRING txn_id, DATETIME ts, DOUBLE amount_usd, STRING product_cd, STRING channel, DOUBLE risk_score, STRING addr1, STRING id_15, STRING id_23, STRING m_flags> TxnRowT;

  SumAccum<INT>    @@count;
  SumAccum<DOUBLE> @@total_amount_usd;
  // ts DESC, not ASC: the heap keeps only 500 rows, and an investigation needs
  // the transactions NEAREST as_of. Ascending kept the OLDEST 500, so any card
  // with a long history returned activity from months before the case and
  // nothing from the window actually under investigation.
  HeapAccum<TxnRowT>(500, ts DESC) @@rows;

  Cards = {Card.*};

  IF entity_type == "card" THEN
    CardHit = SELECT c FROM Cards:c WHERE c.id == entity_id;
    Txns = SELECT t FROM CardHit:c-(MADE)-:t
           WHERE t.ts <= as_of
             AND (window_hours == 0 OR datetime_to_epoch(t.ts) >= datetime_to_epoch(as_of) - window_hours * 3600)
           ACCUM @@count += 1,
                 @@total_amount_usd += t.amount_usd,
                 @@rows += TxnRowT(t.id, t.ts, t.amount_usd, t.product_cd, t.channel, t.risk_score,
                                   t.addr1, t.id_15, t.id_23,
                                   t.m1 + t.m2 + t.m3 + t.m4 + t.m5 + t.m6 + t.m7 + t.m8 + t.m9);
  END;

  IF entity_type == "customer" THEN
    Custs = {Customer.*};
    CustHit = SELECT u FROM Custs:u WHERE u.id == entity_id;
    CustCards = SELECT c FROM CustHit:u-(OWNS)-:c;
    Txns2 = SELECT t FROM CustCards:c-(MADE)-:t
            WHERE t.ts <= as_of
              AND (window_hours == 0 OR datetime_to_epoch(t.ts) >= datetime_to_epoch(as_of) - window_hours * 3600)
            ACCUM @@count += 1,
                  @@total_amount_usd += t.amount_usd,
                  @@rows += TxnRowT(t.id, t.ts, t.amount_usd, t.product_cd, t.channel, t.risk_score,
                                   t.addr1, t.id_15, t.id_23,
                                   t.m1 + t.m2 + t.m3 + t.m4 + t.m5 + t.m6 + t.m7 + t.m8 + t.m9);
  END;

  // A single PRINT statement, not several -- multiple PRINT statements in
  // one query each become a SEPARATE object in the REST response's
  // `results` array instead of merging into one object (verified
  // empirically), which callers reading a single result row would miss.
  // "count" is a reserved word in this GSQL grammar and cannot be used as a
  // PRINT alias (even quoted) -- aliased as txn_count instead.
  PRINT @@rows AS rows, @@count AS txn_count, @@total_amount_usd AS total_amount_usd, window_hours AS window_hours;
}
