// gsql/queries/community_lookup.gsql -- WS2, backs contract tool
// `get_community` (contracts/src/tools.ts GetCommunity).
//
// Schema note (docs/decisions.md "no schema extension" pivot): MATCHES_PATTERN
// only connects FraudCase -> Pattern, not Card -> Pattern, so a discovered
// community id can't be looked up on a Card directly. This query instead
// computes the card's community ON THE FLY and synthesizes its id
// deterministically as "comm_<lexicographically smallest member card id>", so
// repeated lookups from any member card agree on the same id without a
// persisted label.
//
// ---------------------------------------------------------------------------
// Consistency with the batch pass -- why this runs the full computation
// ---------------------------------------------------------------------------
// This query runs the SAME hash-min WCC as algorithms/community_components.gsql,
// with the same two guards (max_hub_degree on the entity side, 2-distinct-types
// + min_overlap_pct on the card side), and simply reads off the seed card's
// label. See that file's header for what the guards are and the measurements
// behind them.
//
// An earlier revision instead did a cheap 3-hop expansion under a
// single-shared-attribute rule, while community_components.gsql and
// discovery_report.gsql used the stricter rule. That was a real defect, not
// just an inconsistency: discovery_report.gsql writes its discovered Pattern
// ids as "disc_c_<smallest member card id>" and this query's comment claimed
// the two agree because "both use smallest member card id" -- but a different
// adjacency rule yields a different component, hence a different smallest
// member, so the ids silently did not match. The agent would get one
// membership from get_community and a different one from the discovered
// pattern for the same cluster. Computing the identical relation is the only
// way that invariant actually holds, so this query pays for it.
//
// Cost: this is a whole-graph computation (~10s on the full 16,324-card
// dataset), not a cheap local expansion -- callers should allow for that
// (the REST endpoint's default 16s timeout is tight; tests/ws2/helpers.ts
// sends a GSQL-TIMEOUT header). That is a deliberate trade: a fast answer
// that disagrees with the discovery pass silently corrupts the agent's
// evidence, which is worse than a slow one. See docs/decisions.md.
//
// algorithms/shortest_path.gsql is deliberately NOT brought in line -- see
// its header comment; it answers a different question.
CREATE QUERY community_lookup(STRING card_id, DATETIME as_of, INT max_hub_degree, INT min_overlap_pct) FOR GRAPH hhgoa_fraud {
  MinAccum<STRING> @label;
  SumAccum<INT>    @degree;
  SumAccum<INT>    @foot;
  SetAccum<STRING> @viaDevice;
  SetAccum<STRING> @viaAddr;
  SetAccum<STRING> @viaEmail;
  MapAccum<STRING, SumAccum<INT>> @overlapCount;
  MapAccum<STRING, SumAccum<INT>> @shared;
  SetAccum<STRING> @strongNeighbors;
  SetAccum<STRING> @srcCards;

  SumAccum<INT> @@round;
  MapAccum<STRING, MinAccum<STRING>> @@globalLabel;
  MapAccum<STRING, MaxAccum<INT>> @@foot;
  MinAccum<STRING> @@seed_label;

  SumAccum<DOUBLE> @@sum_risk;
  SumAccum<INT>    @@n_txns;
  SumAccum<INT>    @@n_cases;
  SumAccum<INT>    @@n_confirmed;
  SumAccum<INT>    @@size;

  AllCards = {Card.*};
  Init = SELECT c FROM AllCards:c
         POST-ACCUM c.@label += c.id, @@globalLabel += (c.id -> c.id);

  DevAll = SELECT d FROM AllCards:c-(CARD_DEVICE:e)-:d
           WHERE e.first_ts <= as_of
           ACCUM d.@degree += 1, c.@foot += 1;
  AddrAll = SELECT a FROM AllCards:c-(CARD_ADDRESS:e)-:a
            WHERE e.first_ts <= as_of
            ACCUM a.@degree += 1, c.@foot += 1;
  EmAll = SELECT x FROM AllCards:c-(CARD_RECIPIENT_EMAIL:e)-:x
          WHERE e.first_ts <= as_of
          ACCUM x.@degree += 1, c.@foot += 1;

  Foot = SELECT c FROM AllCards:c
         POST-ACCUM @@foot += (c.id -> c.@foot);

  DevHub = SELECT d FROM AllCards:c-(CARD_DEVICE:e)-:d
           WHERE e.first_ts <= as_of AND d.@degree <= max_hub_degree
           ACCUM d.@srcCards += c.id;
  DevBack = SELECT c2 FROM DevHub:d-(reverse_CARD_DEVICE:e)-:c2
            WHERE e.first_ts <= as_of
            ACCUM
              FOREACH src IN d.@srcCards DO
                IF src != c2.id THEN
                  c2.@viaDevice += src,
                  c2.@shared += (src -> 1)
                END
              END;

  AddrHub = SELECT a FROM AllCards:c-(CARD_ADDRESS:e)-:a
            WHERE e.first_ts <= as_of AND a.@degree <= max_hub_degree
            ACCUM a.@srcCards += c.id;
  AddrBack = SELECT c2 FROM AddrHub:a-(reverse_CARD_ADDRESS:e)-:c2
             WHERE e.first_ts <= as_of
             ACCUM
               FOREACH src IN a.@srcCards DO
                 IF src != c2.id THEN
                   c2.@viaAddr += src,
                   c2.@shared += (src -> 1)
                 END
               END;

  EmHub = SELECT x FROM AllCards:c-(CARD_RECIPIENT_EMAIL:e)-:x
          WHERE e.first_ts <= as_of AND x.@degree <= max_hub_degree
          ACCUM x.@srcCards += c.id;
  EmBack = SELECT c2 FROM EmHub:x-(reverse_CARD_RECIPIENT_EMAIL:e)-:c2
           WHERE e.first_ts <= as_of
           ACCUM
             FOREACH src IN x.@srcCards DO
               IF src != c2.id THEN
                 c2.@viaEmail += src,
                 c2.@shared += (src -> 1)
               END
             END;

  Overlap = SELECT c FROM AllCards:c
            ACCUM
              FOREACH id1 IN c.@viaDevice DO c.@overlapCount += (id1 -> 1) END,
              FOREACH id2 IN c.@viaAddr DO c.@overlapCount += (id2 -> 1) END,
              FOREACH id3 IN c.@viaEmail DO c.@overlapCount += (id3 -> 1) END
            POST-ACCUM
              FOREACH (nb, cnt) IN c.@overlapCount DO
                IF cnt >= 2 AND
                   c.@shared.get(nb) * 100 >=
                     min_overlap_pct * (c.@foot + @@foot.get(nb) - c.@shared.get(nb)) THEN
                  c.@strongNeighbors += nb
                END
              END;

  WHILE @@round < 6 DO
    Prop = SELECT c FROM AllCards:c
           ACCUM
             FOREACH nb IN c.@strongNeighbors DO
               c.@label += @@globalLabel.get(nb)
             END
           POST-ACCUM @@globalLabel += (c.id -> c.@label);
    @@round += 1;
  END;

  // The hash-min label IS the lexicographically smallest member card id, so
  // the seed's label is exactly the community key. A card with no strong
  // neighbors keeps its own id and reports a community of size 1.
  Seed = SELECT c FROM AllCards:c WHERE c.id == card_id
         POST-ACCUM @@seed_label += c.@label;

  Members = SELECT c FROM AllCards:c WHERE c.@label == @@seed_label
            POST-ACCUM @@size += 1;
  Txns = SELECT t FROM Members:c-(MADE)-:t
         WHERE t.ts <= as_of
         ACCUM @@sum_risk += t.risk_score, @@n_txns += 1;
  Cases = SELECT f FROM Members:c-(reverse_ABOUT:e)-:f
          WHERE e.ts <= as_of
          ACCUM @@n_cases += 1,
                IF f.outcome == "confirmed_fraud" THEN
                  @@n_confirmed += 1
                END;

  DOUBLE avg_risk_score;
  IF @@n_txns > 0 THEN
    avg_risk_score = @@sum_risk / @@n_txns;
  ELSE
    avg_risk_score = 0.0;
  END;
  DOUBLE confirmed_fraud_rate;
  IF @@n_cases > 0 THEN
    confirmed_fraud_rate = @@n_confirmed * 1.0 / @@n_cases;
  ELSE
    confirmed_fraud_rate = 0.0;
  END;

  PRINT ("comm_" + @@seed_label) AS community_id,
        @@size AS size,
        avg_risk_score AS avg_risk_score,
        confirmed_fraud_rate AS confirmed_fraud_rate;
}
