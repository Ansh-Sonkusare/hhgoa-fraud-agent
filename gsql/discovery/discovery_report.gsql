// gsql/discovery/discovery_report.gsql -- WS2 discovery pass (PRD sec.12):
// find shared-entity communities with a confirmed-fraud concentration
// materially above the dataset baseline, and record them as discovered
// Pattern vertices the agent's detect_patterns/get_community tools can
// surface.
//
// Callers MUST run discovery_clear() first, as a SEPARATE installed-query
// invocation (see that file's header for why -- DELETE+INSERT of the same
// vertex id within one query silently nets to a deletion on this build).
// gsql/install.ts does this automatically.
//
// "capped at 3h" (kickoff brief) is read here as "top 3 qualifying
// communities" -- the brief's phrasing is ambiguous between a 3-hour temporal
// window and a top-3 cap; there is no natural "3 hour" temporal cutoff for a
// batch discovery pass over already-closed cases, so top-3 was chosen. See
// docs/decisions.md for this judgment call.
//
// "without a matching detector" is read as a structural claim, not a
// literal case.pattern=="undocumented" filter: only 4 of 5,565 closed
// cases in the real dataset actually carry that label (verified via spike
// query), so requiring it here would make discovery fire on essentially
// nothing. The five detectors under detectors/ each look for a specific
// per-transaction signature; discovery's job is the complementary
// structural signal -- a shared-entity cluster with a confirmed-fraud
// concentration that a per-card detector call would never surface,
// regardless of what pattern label its historical cases carry.
// See docs/decisions.md for this judgment call.
//
// ---------------------------------------------------------------------------
// Qualifying rule: min_confirmed_pct must beat the BASELINE, not 50%
// ---------------------------------------------------------------------------
// Qualifying community: >= 2 member cards, >= 2 connected FraudCases, and
// n_confirmed / n_cases >= min_confirmed_pct / 100 (opened_at/edge ts <=
// as_of, PRD sec.8.1).
//
// min_confirmed_pct's default is 90 (gsql/install.ts), NOT 50. An earlier
// revision used a hardcoded 50% bar, which is meaningless on this dataset:
// measured over all closed cases, 4,473 of 5,373 with a recorded outcome are
// confirmed fraud -- an 83.2% BASELINE. A 50% bar is 33 points BELOW chance,
// so essentially any cluster that has cases at all passes it, and "high
// confirmed-fraud concentration" was not actually being tested. The one
// Pattern that revision emitted had a 40/49 = 81.6% rate: below baseline,
// i.e. slightly LESS fraudulent than a random cluster, presented to the agent
// as a discovered fraud ring. The bar has to clear the baseline by enough to
// mean something, hence 90.
//
// Recomputes the same hash-min WCC labeling as
// algorithms/community_components.gsql inline (RUN QUERY composition
// across installed queries is not relied upon -- unverified on this build,
// see docs/decisions.md), including both of its guards: max_hub_degree on
// the entity side, and the 2-distinct-types + min_overlap_pct bar on the
// card side. See that file's header for the measurements behind them -- in
// particular why the old single-guard version produced a 274-card component
// that was a transaction-volume artifact rather than a fraud ring, and why
// that artifact is what this pass used to report.
//
// Schema note: MATCHES_PATTERN only connects FraudCase -> Pattern (not
// Card -> Pattern -- ALTER GRAPH is unsupported on this build, so Pattern
// is reused as-is rather than extending the schema). A discovered
// community's Pattern id is "disc_c_<min_card_id>", matching the
// community_id community_lookup.gsql computes for the same cluster -- which
// holds only because that query now computes the identical relation.
CREATE QUERY discovery_report(DATETIME as_of, INT max_hub_degree, INT min_overlap_pct, INT min_confirmed_pct) FOR GRAPH hhgoa_fraud {
  TYPEDEF TUPLE<STRING comp_id, INT size, INT n_cases, INT n_confirmed, INT n_undocumented> CompStatT;

  MinAccum<STRING> @label;
  SumAccum<INT>    @degree;
  SumAccum<INT>    @foot;
  SetAccum<STRING> @viaDevice;
  SetAccum<STRING> @viaAddr;
  SetAccum<STRING> @viaEmail;
  MapAccum<STRING, SumAccum<INT>> @overlapCount;
  MapAccum<STRING, SumAccum<INT>> @shared;
  SetAccum<STRING> @strongNeighbors;
  SetAccum<STRING> @srcCards;

  SumAccum<INT>    @@round;
  HeapAccum<CompStatT>(3, n_confirmed DESC) @@top_components;
  MapAccum<STRING, MinAccum<STRING>> @@globalLabel;
  MapAccum<STRING, MaxAccum<INT>> @@foot;

  AllCards = {Card.*};
  Init = SELECT c FROM AllCards:c
         POST-ACCUM c.@label += c.id, @@globalLabel += (c.id -> c.id);

  DevAll = SELECT d FROM AllCards:c-(CARD_DEVICE:e)-:d
           WHERE e.first_ts <= as_of
           ACCUM d.@degree += 1, c.@foot += 1;
  AddrAll = SELECT a FROM AllCards:c-(CARD_ADDRESS:e)-:a
            WHERE e.first_ts <= as_of
            ACCUM a.@degree += 1, c.@foot += 1;
  EmAll = SELECT x FROM AllCards:c-(CARD_RECIPIENT_EMAIL:e)-:x
          WHERE e.first_ts <= as_of
          ACCUM x.@degree += 1, c.@foot += 1;

  Foot = SELECT c FROM AllCards:c
         POST-ACCUM @@foot += (c.id -> c.@foot);

  DevHub = SELECT d FROM AllCards:c-(CARD_DEVICE:e)-:d
           WHERE e.first_ts <= as_of AND d.@degree <= max_hub_degree
           ACCUM d.@srcCards += c.id;
  DevBack = SELECT c2 FROM DevHub:d-(reverse_CARD_DEVICE:e)-:c2
            WHERE e.first_ts <= as_of
            ACCUM
              FOREACH src IN d.@srcCards DO
                IF src != c2.id THEN
                  c2.@viaDevice += src,
                  c2.@shared += (src -> 1)
                END
              END;

  AddrHub = SELECT a FROM AllCards:c-(CARD_ADDRESS:e)-:a
            WHERE e.first_ts <= as_of AND a.@degree <= max_hub_degree
            ACCUM a.@srcCards += c.id;
  AddrBack = SELECT c2 FROM AddrHub:a-(reverse_CARD_ADDRESS:e)-:c2
             WHERE e.first_ts <= as_of
             ACCUM
               FOREACH src IN a.@srcCards DO
                 IF src != c2.id THEN
                   c2.@viaAddr += src,
                   c2.@shared += (src -> 1)
                 END
               END;

  EmHub = SELECT x FROM AllCards:c-(CARD_RECIPIENT_EMAIL:e)-:x
          WHERE e.first_ts <= as_of AND x.@degree <= max_hub_degree
          ACCUM x.@srcCards += c.id;
  EmBack = SELECT c2 FROM EmHub:x-(reverse_CARD_RECIPIENT_EMAIL:e)-:c2
           WHERE e.first_ts <= as_of
           ACCUM
             FOREACH src IN x.@srcCards DO
               IF src != c2.id THEN
                 c2.@viaEmail += src,
                 c2.@shared += (src -> 1)
               END
             END;

  Overlap = SELECT c FROM AllCards:c
            ACCUM
              FOREACH id1 IN c.@viaDevice DO c.@overlapCount += (id1 -> 1) END,
              FOREACH id2 IN c.@viaAddr DO c.@overlapCount += (id2 -> 1) END,
              FOREACH id3 IN c.@viaEmail DO c.@overlapCount += (id3 -> 1) END
            POST-ACCUM
              FOREACH (nb, cnt) IN c.@overlapCount DO
                IF cnt >= 2 AND
                   c.@shared.get(nb) * 100 >=
                     min_overlap_pct * (c.@foot + @@foot.get(nb) - c.@shared.get(nb)) THEN
                  c.@strongNeighbors += nb
                END
              END;

  WHILE @@round < 6 DO
    Prop = SELECT c FROM AllCards:c
           ACCUM
             FOREACH nb IN c.@strongNeighbors DO
               c.@label += @@globalLabel.get(nb)
             END
           POST-ACCUM @@globalLabel += (c.id -> c.@label);
    @@round += 1;
  END;

  // Component membership size, keyed by label.
  MapAccum<STRING, SumAccum<INT>> @@comp_size;
  Summ = SELECT c FROM AllCards:c
         ACCUM @@comp_size += (c.@label -> 1);

  // Per-component case stats: total connected cases, confirmed_fraud count,
  // undocumented-pattern count.
  MapAccum<STRING, SumAccum<INT>> @@comp_cases;
  MapAccum<STRING, SumAccum<INT>> @@comp_confirmed;
  MapAccum<STRING, SumAccum<INT>> @@comp_undoc;
  Cases = SELECT f FROM AllCards:c-(reverse_ABOUT:e)-:f
          WHERE e.ts <= as_of AND f.opened_at <= as_of
          ACCUM
            @@comp_cases += (c.@label -> 1),
            IF f.outcome == "confirmed_fraud" THEN
              @@comp_confirmed += (c.@label -> 1)
            END,
            IF f.pattern == "undocumented" THEN
              @@comp_undoc += (c.@label -> 1)
            END;

  FOREACH (compId, size) IN @@comp_size DO
    INT nCases;
    INT nConfirmed;
    INT nUndoc;
    IF @@comp_cases.containsKey(compId) THEN
      nCases = @@comp_cases.get(compId);
    ELSE
      nCases = 0;
    END;
    IF @@comp_confirmed.containsKey(compId) THEN
      nConfirmed = @@comp_confirmed.get(compId);
    ELSE
      nConfirmed = 0;
    END;
    IF @@comp_undoc.containsKey(compId) THEN
      nUndoc = @@comp_undoc.get(compId);
    ELSE
      nUndoc = 0;
    END;
    IF size >= 2 AND nCases >= 2 THEN
      IF nConfirmed * 100 >= min_confirmed_pct * nCases THEN
        @@top_components += CompStatT(compId, size, nCases, nConfirmed, nUndoc);
      END;
    END;
  END;

  // Write: upsert one discovered Pattern per qualifying (top-3) component,
  // then connect every qualifying FraudCase in that component to it via
  // MATCHES_PATTERN (score = the component's confirmed-fraud rate).
  SetAccum<STRING> @@qualifying;
  FOREACH comp IN @@top_components DO
    @@qualifying += comp.comp_id;
    INSERT INTO Pattern VALUES(
      "disc_c_" + comp.comp_id,
      "Discovered cluster " + comp.comp_id,
      "discovered",
      "Discovered community of " + to_string(comp.size) + " cards linked by shared devices/billing regions/recipient email domains (2+ distinct entity types and >= " +
        to_string(min_overlap_pct) + "% footprint overlap per link), with " +
        to_string(comp.n_confirmed) + " of " + to_string(comp.n_cases) +
        " connected cases confirmed fraud -- against an 83.2% dataset-wide baseline."
    );
  END;

  CasesToLink = SELECT f FROM AllCards:c-(reverse_ABOUT:e)-:f
                WHERE e.ts <= as_of AND f.opened_at <= as_of AND @@qualifying.contains(c.@label)
                ACCUM INSERT INTO MATCHES_PATTERN VALUES(f.id, "disc_c_" + c.@label, 1.0);

  PRINT @@top_components AS top_discovered_components;
}
