// gsql/detectors/det_cnp_new_device.gsql -- WS2. Pattern 3 "CNP fraud from
// a new device" (README: same signature as pattern 2, plus the identity
// record marks the device as New for this account (id_15), sometimes
// behind a proxy (id_23)). id_15/id_23 are loaded Txn columns (see
// graph/schema.gsql / docs/DATA_MAP.md's "not loaded" exceptions), so no
// extra hop to Identity is needed. ts <= as_of only (PRD sec.8.1).
CREATE QUERY det_cnp_new_device(STRING card_id, DATETIME as_of) FOR GRAPH hhgoa_fraud {
  SumAccum<INT>    @@burst_count;
  SumAccum<INT>    @@new_device_count;
  SumAccum<INT>    @@proxy_count;
  SetAccum<STRING> @@evidence;

  Cards = {Card.*};
  CardHit = SELECT c FROM Cards:c WHERE c.id == card_id;

  Burst = SELECT t FROM CardHit:c-(MADE)-:t
          WHERE t.ts <= as_of
            AND t.channel == "online"
            AND datetime_to_epoch(t.ts) >= datetime_to_epoch(as_of) - 48 * 3600
          ACCUM
            @@burst_count += 1,
            IF t.id_15 == "New" THEN
              @@new_device_count += 1,
              @@evidence += t.id
            END,
            IF t.id_23 != "" THEN
              @@proxy_count += 1
            END;

  DOUBLE score;
  score = 0.0;
  IF @@burst_count >= 2 AND @@new_device_count >= 1 THEN
    IF @@proxy_count >= 1 THEN
      score = 0.85;
    ELSE
      score = 0.65;
    END;
  END;

  PRINT score AS score, @@evidence AS evidence_rows;
}
