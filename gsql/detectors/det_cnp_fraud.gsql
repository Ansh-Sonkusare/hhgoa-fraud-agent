// gsql/detectors/det_cnp_fraud.gsql -- WS2. Pattern 2 "card-not-present
// fraud" (README: amount/product doesn't fit history, burst of 2-4 online
// txns within 48h; Policy R1-R4). ts <= as_of only (PRD sec.8.1).
//
// Documented simplification: "doesn't fit history" is approximated as
// amount_usd > 2x the card's own mean prior amount (ts < as_of) rather than
// a full per-product_cd baseline -- see baseline_deviation.gsql for the
// more careful per-txn z-score version used elsewhere; this detector needs
// a cheap whole-window signal instead.
CREATE QUERY det_cnp_fraud(STRING card_id, DATETIME as_of) FOR GRAPH hhgoa_fraud {
  SumAccum<INT>    @@prior_n;
  SumAccum<DOUBLE> @@prior_sum;
  SumAccum<INT>    @@burst_count;
  SumAccum<INT>    @@outlier_count;
  SetAccum<STRING> @@evidence;

  Cards = {Card.*};
  CardHit = SELECT c FROM Cards:c WHERE c.id == card_id;

  Prior = SELECT p FROM CardHit:c-(MADE)-:p
          WHERE p.ts < as_of
          ACCUM @@prior_n += 1, @@prior_sum += p.amount_usd;

  DOUBLE mean_amt;
  IF @@prior_n > 0 THEN
    mean_amt = @@prior_sum / @@prior_n;
  ELSE
    mean_amt = 0.0;
  END;

  Burst = SELECT t FROM CardHit:c-(MADE)-:t
          WHERE t.ts <= as_of
            AND t.channel == "online"
            AND datetime_to_epoch(t.ts) >= datetime_to_epoch(as_of) - 48 * 3600
          ACCUM
            @@burst_count += 1,
            @@evidence += t.id,
            IF mean_amt > 0 AND t.amount_usd > 2 * mean_amt THEN
              @@outlier_count += 1
            END;

  DOUBLE score;
  score = 0.0;
  IF @@burst_count >= 2 AND @@burst_count <= 6 THEN
    IF @@outlier_count >= 1 THEN
      score = 0.8;
    ELSE
      score = 0.4;
    END;
  END;

  PRINT score AS score, @@evidence AS evidence_rows;
}
