// gsql/detectors/det_account_takeover.gsql -- WS2. Pattern 5 "account
// takeover" (README: mixed-channel activity inconsistent with the
// cardholder, often with device and match-flag anomalies). ts <= as_of only
// (PRD sec.8.1).
//
// Documented simplification: "inconsistent with the cardholder" is
// approximated by two signals within a 7-day window before as_of: (a) both
// channels (online AND in_person) appear, and (b) at least 2 of the m1..m9
// match-flag columns read "F" (mismatch) on any txn in that window -- m1..m9
// are the loaded IEEE-CIS match-flag columns (graph/schema.gsql).
CREATE QUERY det_account_takeover(STRING card_id, DATETIME as_of) FOR GRAPH hhgoa_fraud {
  SumAccum<INT>    @@online_count;
  SumAccum<INT>    @@in_person_count;
  SumAccum<INT>    @@mismatch_count;
  SetAccum<STRING> @@evidence;

  Cards = {Card.*};
  CardHit = SELECT c FROM Cards:c WHERE c.id == card_id;

  Recent = SELECT t FROM CardHit:c-(MADE)-:t
           WHERE t.ts <= as_of
             AND datetime_to_epoch(t.ts) >= datetime_to_epoch(as_of) - 7 * 86400
           ACCUM
             IF t.channel == "online" THEN
               @@online_count += 1
             ELSE
               @@in_person_count += 1
             END,
             IF t.m1 == "F" THEN @@mismatch_count += 1 END,
             IF t.m2 == "F" THEN @@mismatch_count += 1 END,
             IF t.m3 == "F" THEN @@mismatch_count += 1 END,
             IF t.m4 == "F" THEN @@mismatch_count += 1 END,
             IF t.m5 == "F" THEN @@mismatch_count += 1 END,
             IF t.m6 == "F" THEN @@mismatch_count += 1 END,
             IF t.m7 == "F" THEN @@mismatch_count += 1 END,
             IF t.m8 == "F" THEN @@mismatch_count += 1 END,
             IF t.m9 == "F" THEN @@mismatch_count += 1 END,
             @@evidence += t.id;

  BOOL mixed_channel;
  IF @@online_count >= 1 AND @@in_person_count >= 1 THEN
    mixed_channel = TRUE;
  ELSE
    mixed_channel = FALSE;
  END;

  DOUBLE score;
  score = 0.0;
  IF mixed_channel THEN
    IF @@mismatch_count >= 2 THEN
      score = 0.8;
    ELSE
      score = 0.45;
    END;
  END;

  PRINT score AS score, @@evidence AS evidence_rows;
}
