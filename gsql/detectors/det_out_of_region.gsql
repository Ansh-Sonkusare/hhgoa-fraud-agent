// gsql/detectors/det_out_of_region.gsql -- WS2. Pattern 4 "out-of-region
// use" (README: card-present purchases in a billing region (addr1) with no
// prior history there, while home activity continues; Policy R2, R3). ts <=
// as_of only (PRD sec.8.1).
CREATE QUERY det_out_of_region(STRING card_id, DATETIME as_of) FOR GRAPH hhgoa_fraud {
  SetAccum<STRING> @@home_addrs;
  SumAccum<INT>    @@home_recent_count;
  SumAccum<INT>    @@new_region_count;
  SetAccum<STRING> @@evidence;

  Cards = {Card.*};
  CardHit = SELECT c FROM Cards:c WHERE c.id == card_id;

  Prior = SELECT p FROM CardHit:c-(MADE)-:p
          WHERE p.ts < as_of
            AND datetime_to_epoch(p.ts) < datetime_to_epoch(as_of) - 7 * 86400
          ACCUM @@home_addrs += p.addr1;

  Recent = SELECT t FROM CardHit:c-(MADE)-:t
           WHERE t.ts <= as_of
             AND datetime_to_epoch(t.ts) >= datetime_to_epoch(as_of) - 7 * 86400
           ACCUM
             IF t.channel == "in_person" AND NOT @@home_addrs.contains(t.addr1) THEN
               @@new_region_count += 1,
               @@evidence += t.id
             ELSE
               @@home_recent_count += 1
             END;

  DOUBLE score;
  score = 0.0;
  IF @@home_addrs.size() > 0 AND @@new_region_count >= 1 THEN
    IF @@home_recent_count >= 1 THEN
      score = 0.75;
    ELSE
      score = 0.5;
    END;
  END;

  PRINT score AS score, @@evidence AS evidence_rows;
}
