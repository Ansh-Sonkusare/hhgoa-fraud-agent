// gsql/detectors/det_card_testing.gsql -- WS2. Pattern 1 "card testing"
// (README: >=3 small online auths, often <$5, then a larger purchase;
// Policy R5: within one hour, followed by DECLINE_TRANSACTION/STEP_UP_AUTH,
// or BLOCK_CARD if a purchase over $100 already cleared). Only counts txns
// with ts <= as_of (PRD sec.8.1).
//
// Documented simplification: true sliding-1-hour-window burst detection
// needs pairwise timestamp comparison this single-hop-only GSQL dialect
// can't express cheaply, so this counts small online txns across the
// card's whole as-of history and treats >=3 as a hit -- a real card-testing
// burst always satisfies this count; a legitimate cardholder occasionally
// making several small online purchases over months is a plausible (rare)
// false positive the evidence list lets a reviewer rule out at a glance.
CREATE QUERY det_card_testing(STRING card_id, DATETIME as_of) FOR GRAPH hhgoa_fraud {
  SumAccum<INT>      @@small_count;
  SumAccum<INT>      @@large_count;
  SetAccum<STRING>   @@evidence;

  Cards = {Card.*};
  CardHit = SELECT c FROM Cards:c WHERE c.id == card_id;
  Txns = SELECT t FROM CardHit:c-(MADE)-:t
         WHERE t.ts <= as_of AND t.channel == "online"
         ACCUM
           IF t.amount_usd < 5.0 THEN
             @@small_count += 1,
             @@evidence += t.id
           END,
           IF t.amount_usd > 100.0 THEN
             @@large_count += 1,
             @@evidence += t.id
           END;

  DOUBLE score;
  score = 0.0;
  IF @@small_count >= 3 THEN
    IF @@large_count >= 1 THEN
      score = 0.9;
    ELSE
      score = 0.55;
    END;
  END;

  PRINT score AS score, @@evidence AS evidence_rows;
}
