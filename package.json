{
  "name": "hhgoa-fraud-agent",
  "private": true,
  "version": "0.1.0",
  "description": "TigerGraph Hacker House Goa fraud investigation agent",
  "packageManager": "pnpm@9.15.0",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:contracts": "turbo run test --filter=@hhgoa/contracts",
    "test:ws6": "pnpm --filter @hhgoa/api test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev --parallel",
    "dev:api": "pnpm --filter @hhgoa/api dev",
    "dev:ui": "pnpm --filter @hhgoa/ui dev",
    "start": "turbo run start --parallel",
    "verify-graph": "pnpm --filter @hhgoa/graph verify && pnpm --filter @hhgoa/graph mcp:smoke",
    "verify-gsql": "pnpm --filter @hhgoa/gsql verify",
    "mcp:up": "docker compose up -d --build tigergraph mcp-server",
    "mcp:down": "docker compose stop tigergraph mcp-server",
    "run-case": "make run-case",
    "run-all": "make run-all",
    "validate-answers": "make validate-answers"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "turbo": "^2.1.3",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=20"
  }
}
