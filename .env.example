# --- Tool backend switch (PRD §8.6) ---
TOOLS_BACKEND=fake                 # fake | real — fake uses contracts/src/fakes.ts

# --- Agent budgets (PRD §9.2) ---
MAX_TOOL_CALLS=25
MAX_EVIDENCE_ROUNDS=2
MAX_INVESTIGATE_LOOPS=4

# --- LLM (PRD §5, OQ7): free/local, no paid API — see docs/decisions.md ---
LLM_BACKEND=ollama                 # ollama | openai — openai = any OpenAI-compatible /v1 chat endpoint (e.g. local llama.cpp llama-server)
OLLAMA_HOST=http://localhost:11434 # Docker-hosted Ollama (docker-compose.yml)
OLLAMA_MODEL=                      # e.g. qwen2.5:1.5b — set once a model is pulled
LLM_BASE_URL=http://localhost:8080 # OpenAI-compatible base URL for LLM_BACKEND=openai (llama.cpp llama-server default port). llama.cpp needs a big context for the assessor brief (~13k tokens): run with `-c 32768` (or at least `-c 16384`).
LLM_MODEL=                         # model name for LLM_BACKEND=openai (e.g. Qwen/Qwen2.5-7B-Instruct-GGUF:Q4_K_M); falls back to OLLAMA_MODEL
GROQ_API_KEY=                      # optional cloud fallback (free tier, manual signup at console.groq.com) — unused unless LLM_BACKEND=groq
LLM_REQUEST_TIMEOUT_S=300          # abort one chat completion after this long (0 = no limit); a stalled generation fails the call, not the run
ASSESSOR_STAGES=1                  # 1 = single assessor call (default; measured 47.1% pattern / 0 FN); 2 = triage then calibrate (measured 17.6% / 6 FN) — see docs/decisions.md
MCP_CALL_TIMEOUT_S=120             # abort one TigerGraph MCP round-trip (connect or query) after this long (0 = no limit)

# --- TigerGraph Community Edition (Docker, docker-compose.yml) or Savanna (PRD §7, §18.1) ---
TIGERGRAPH_HOST=                   # e.g. http://localhost:9000 (Docker CE) or https://<workspace>.i.tgcloud.io (Savanna)
TIGERGRAPH_GRAPH_NAME=hhgoa_fraud
TIGERGRAPH_USERNAME=
TIGERGRAPH_PASSWORD=
TIGERGRAPH_REST_PORT=9000
TIGERGRAPH_GSQL_PORT=14240

# --- TigerGraph MCP server (PRD §8.4, §9.4; https://github.com/tigergraph/tigergraph-mcp) ---
TIGERGRAPH_MCP_URL=

# --- Fastify API + SSE (PRD §5, §14) ---
API_PORT=4000
# Case-run source for the API (WS6): "fixture" (default) replays recorded
# fixture runs over SSE; "live" runs the real WS4 agent as cases are opened
# (TOOLS_BACKEND / LLM_BACKEND above decide the graph + LLM backends).
RUN_SOURCE=fixture

# --- UI (PRD §14) ---
UI_PORT=3000
API_BASE_URL=http://localhost:4000

# --- Approvals (PRD §10.4) — Discord is optional, never on the critical path ---
DISCORD_APPROVAL_WEBHOOK_URL=

# --- Local embeddings (PRD §5, OQ7): @xenova/transformers, no external key needed ---
EMBEDDINGS_MODEL=bge-small-en-v1.5

# Pattern scorer (agent/src/patternScorer.ts): a decision model that ranks the five documented
# patterns after the LLM's assessment; the LLM keeps the fraud-vs-legitimate judgement.
# PATTERN_SCORER=jev|kev|none (default: jev when JEV_API_KEY is set, else kev when KEV_URL is set, else none)
JEV_API_KEY=                       # TypeSafe System One key (https://docs.typesafe.ai/api)
JEV_URL=https://api.typesafe.ai
KEV_URL=                           # local `python -m kev.serve` (e.g. http://127.0.0.1:8009), optional
# RAG similarity backend: tigergraph (vector_search over PolicyChunk/FraudCase embeddings) | local
RAG_VECTOR_BACKEND=local
