# graph/mcp-server/.env.example — only needed for the native (non-Docker) path:
# copy to graph/mcp-server/.env (gitignored) and start with
# `pnpm --filter @hhgoa/graph mcp:start`. Values below are the TigerGraph
# Community Edition container's local-dev defaults (docker-compose.yml).
#
# The recommended path is `make mcp-up` instead (root docker-compose.yml's
# `mcp-server` service, built from this directory's Dockerfile) — it needs no
# .env file; its config is set directly in docker-compose.yml's `environment:`
# block (same default values, but TG_HOST=http://tigergraph, the compose
# network's service name, instead of localhost).
TG_HOST=http://localhost
TG_GRAPHNAME=hhgoa_fraud
TG_USERNAME=tigergraph
TG_PASSWORD=tigergraph
TG_RESTPP_PORT=9000
TG_GS_PORT=14240
