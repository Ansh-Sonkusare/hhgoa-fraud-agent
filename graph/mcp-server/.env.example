# graph/mcp-server/.env.example — copy to graph/mcp-server/.env (gitignored)
# and start with `pnpm --filter @hhgoa/graph mcp:start`. Values below are the
# TigerGraph Community Edition container's local-dev defaults (docker-compose.yml).
TG_HOST=http://localhost
TG_GRAPHNAME=hhgoa_fraud
TG_USERNAME=tigergraph
TG_PASSWORD=tigergraph
TG_RESTPP_PORT=9000
TG_GS_PORT=14240
